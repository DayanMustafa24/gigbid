.PHONY: install dev api worker openapi ts-client migrate test lint eval seed demo gigsim rag-eval rag-ablation rag-verify rag-smoke graphs rdc rdc-offline
install:
	uv sync --extra dev

dev: api

api:
	uv run uvicorn apps.api.main:app --reload --port 8000

# Arq worker (needs Redis at REDIS_URL): scheduled scout, outcome sync, stale-run recovery
worker:
	uv run arq worker.main.WorkerSettings

# Phase 6.3: OpenAPI contract -> apps/api/openapi.json (the TypeScript client is generated from it in Phase 7)
openapi:
	uv run python -m scripts.export_openapi

# Phase 6.3: typed TypeScript client generated from the contract (Node 20+): apps/web/src/lib/api/schema.d.ts
ts-client:
	uv run python -m scripts.gen_ts_client

# Database schema: Alembic migrations (apps/api/migrations). Run before starting the API against Postgres.
migrate:
	uv run python -m apps.api.migrate upgrade

test:
	uv run pytest -q

lint:
	uv run ruff check .

eval: rag-eval rag-ablation rag-verify

# Phase 1 data layer (deterministic). Needs `uv sync --extra dev --extra data`.
seed:
	uv run python -m scripts.parse_upwork
	uv run python -m scripts.synth.build_personas
	uv run python -m scripts.synth.build_jobs

demo:
	@echo "TODO Phase 8: docker compose -f infra/docker-compose.yml up"

# Phase 2: local marketplace simulator on :8081 (set GIGSIM_DATASET=sample to run without `make seed`)
gigsim:
	uv run python -m gigsim_local

# Phase 4: RAG evals. Embedder/reranker come from agent/config.yaml (rag.*) or env RAG_EMBEDDER / RAG_RERANKER.
# Writes evals/results/rag_eval*, rag_ablation*, rag_verify_eval.json (regenerated by one command: `make eval`).
rag-smoke:
	uv run python -m evals.runners.rag_eval --limit 20 --stem rag_smoke

rag-eval:
	uv run python -m evals.runners.rag_eval

rag-ablation:
	uv run python -m evals.runners.ablation

rag-verify:
	uv run python -m evals.runners.verify_eval

# Phase 5.9 R&D-C: single agent vs supervisor vs hand graph on 50 dev jobs (real models; writes evals/results/rdc_architectures.*)
rdc:
	uv run python -m evals.runners.rdc_architectures --sample 50 --seed 42

# plumbing check with a scripted stand-in LLM (labelled OFFLINE; never quote these numbers)
rdc-offline:
	uv run python -m evals.runners.rdc_architectures --offline --sample 12

# Phase 5: architecture diagrams generated from the compiled graphs -> docs/images/*.mmd (add --png if `mmdc` is installed)
graphs:
	uv run python -m scripts.render_graphs
