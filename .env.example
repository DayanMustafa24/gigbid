# Copy to .env and fill in. Never commit .env. Every variable the system reads is listed here.
APP_ENV=development
APP_SECRET_KEY=replace_me                 # signs sessions
TOKEN_ENCRYPTION_KEY=                      # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"

# --- infra ---
DATABASE_URL=postgresql://gigbid:gigbid@localhost:5432/gigbid
REDIS_URL=redis://localhost:6379/0
APP_DATABASE_URL=sqlite+aiosqlite:///data/app/gigbid.sqlite   # users/runs/events. Production: postgresql+psycopg://gigbid:gigbid@postgres:5432/gigbid
POSTGRES_PASSWORD=gigbid                   # compose only; change on a public host
CHECKPOINTER=sqlite                        # memory | sqlite | postgres (graph checkpoints; production: postgres)
REVIEWER_EMAIL=                            # optional login seeded at startup (deployment reviewer account)
REVIEWER_PASSWORD=
SESSION_TTL_MINUTES=480
COOKIE_SECURE=false                        # true behind HTTPS

# --- marketplace (R1: switch by config, graph never knows) ---
MARKETPLACE_MODE=gigsim                    # gigsim | upwork
GIGSIM_BASE_URL=http://localhost:8081
GIGSIM_API_TOKEN=replace_me
UPWORK_MCP_URL=https://mcp.upwork.com/mcp

# --- own MCP servers (Streamable HTTP) ---
MCP_PORTFOLIO_URL=http://localhost:9101/mcp
MCP_MARKETPLACE_URL=http://localhost:9102/mcp
MCP_WORKSPACE_URL=http://localhost:9103/mcp
MCP_BEARER_TOKEN=replace_me

# --- third-party MCP ---
GITHUB_PERSONAL_ACCESS_TOKEN=              # fine-grained, read-only

# --- models: profile picks node->model map in agent/config.yaml ---
MODEL_PROFILE=open                         # open | paid
OLLAMA_BASE_URL=http://localhost:11434/v1
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=                            # only for the optional paid profile

# --- observability ---
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=gigbid
TRACING=off                                # on | off. Set off unless Phoenix is running (otherwise export errors in the log)
LANGSMITH_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
